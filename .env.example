# Freshapp Music Tagger — copy to .env and adjust.
PORT=8085

# Login. Prefer a hash: docker compose run --rm music-tagger python -m app.auth hash
# Without any password, one is generated at first start (see the container logs).
APP_USER=admin
APP_PASSWORD=
APP_PASSWORD_HASH=
# auto = Secure cookie when served over HTTPS (reverse proxy sending X-Forwarded-Proto)
COOKIE_SECURE=auto
PUID=1000
PGID=1000

# ---- Music library ---------------------------------------------------------
# A) App on the NAS itself (recommended): folder that contains the library,
#    e.g. /mnt/nvme/medias or /volume1/Medias. Required.
#    If you change it after a first start: docker compose down && docker volume rm music-tagger_music
MUSIC_DEVICE=

# B) App on another machine: uncomment to mount the NAS share over SMB
# SMB_HOST=192.168.1.10
# SMB_SHARE=Medias
# SMB_USER=
# SMB_PASSWORD=
# MUSIC_MOUNT_TYPE=cifs
# MUSIC_DEVICE=//${SMB_HOST}/${SMB_SHARE}
# MUSIC_MOUNT_OPTIONS=username=${SMB_USER},password=${SMB_PASSWORD},uid=${PUID},gid=${PGID},vers=3.0,iocharset=utf8,file_mode=0664,dir_mode=0775

# Sub-folder of MUSIC_DEVICE holding the music (empty = MUSIC_DEVICE itself)
MUSIC_SUBDIR=Music

# MusicBrainz asks for a contact in the User-Agent (optional)
MB_USER_AGENT=freshapp-music-tagger/1.0 ( you@example.com )

# Optional: lets the app trigger a Navidrome rescan (admin account)
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=

SCAN_THREADS=8
