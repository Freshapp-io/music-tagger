# Freshapp Music Tagger — copy to .env and adjust.
PORT=8085
PUID=1000
PGID=1000

# Folder inside the mounted volume that holds the library (e.g. Medias/Music)
MUSIC_SUBDIR=Music

# A) running on the NAS: absolute path of the shared folder on the NAS
MUSIC_PATH=/volume1/Medias

# B) running on a PC: SMB share (block B in docker-compose.yml)
SMB_HOST=192.168.1.10
SMB_SHARE=Medias
SMB_USER=
SMB_PASSWORD=

# MusicBrainz asks for a contact in the User-Agent (optional)
MB_USER_AGENT=freshapp-music-tagger/1.0 ( you@example.com )

# Optional: lets the app trigger a Navidrome rescan (admin account)
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=

SCAN_THREADS=8
